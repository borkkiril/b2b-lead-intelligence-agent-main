# ==============================================================================
# AI Prospecting Agent — Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in the values below.
# NEVER commit the actual '.env' file to public version control.

# AI Model Configuration (Optional / Used for Agent Simulations)
# Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional): https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration (Optional overrides)
# DB_PATH=data/leads.db
# FLET_SERVER_PORT=8502
